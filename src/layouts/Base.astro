---
import '../styles/global.css';
import { SITE_NAME, abs, clip } from '../lib/seo.ts';
import { FULL_TITLE, LINKS } from '../data/paper.ts';

interface Props {
  title: string;
  description: string;
  og?: string;
  jsonld?: Record<string, unknown>[];
  type?: 'website' | 'article';
  noSuffix?: boolean;
  noindex?: boolean;
}

const { title, description: rawDescription, og = '/og/default.png', jsonld = [], type = 'website', noSuffix = false, noindex = false } = Astro.props;
const description = clip(rawDescription);
const suffixed = `${title} | ${SITE_NAME}`;
const fullTitle = noSuffix || suffixed.length > 65 ? title : suffixed;
const canonical = abs(Astro.url.pathname);
const path = Astro.url.pathname;
// Google Search Console ownership token (public by design; it is served in every page head).
const verification = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION || 'hO7eAu7QRYgl9wemtxeEwkdTl3fSaWHbdLxPaDjm5S4';

const NAV: [string, string][] = [
  ['Formation & Representation', '/formation/'],
  ['Management', '/management/'],
  ['Modalities', '/modalities/'],
  ['Systems', '/systems/'],
  ['Benchmarks', '/benchmarks/'],
  ['Paper', '/paper/'],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="robots" content={noindex ? 'noindex' : 'index, follow, max-image-preview:large'} />
    {verification && <meta name="google-site-verification" content={verification} />}
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={abs(og)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={FULL_TITLE} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={abs(og)} />
    <meta name="theme-color" content="#ecebe6" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1318" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch (e) {}
    </script>
    <slot name="head" />
    {jsonld.map((j) => <script type="application/ld+json" set:html={JSON.stringify(j).replace(/</g, '\\u003c')} />)}
  </head>
  <body>
    <a class="skip sr-only" href="#main">Skip to content</a>
    <header class="top">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="Multimodal Agent Memory Survey home">
          <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <circle cx="6" cy="12" r="3" fill="var(--t1)"></circle>
            <circle cx="12" cy="12" r="3" fill="var(--t2)"></circle>
            <circle cx="18" cy="12" r="3" fill="var(--t3)"></circle>
          </svg>
          <span>Multimodal Agent Memory</span>
        </a>
        <nav aria-label="Sections">
          <ul>
            {
              NAV.map(([label, href]) => (
                <li>
                  <a href={href} aria-current={path.startsWith(href) ? 'page' : undefined}>
                    {label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <a class="submit" href="/contribute/">Submit a paper</a>
        <button class="theme" type="button" aria-label="Toggle color theme" title="Toggle color theme">
          <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
            <path d="M12 3a9 9 0 1 0 9 9A9 9 0 0 0 12 3Zm0 16V5a7 7 0 0 1 0 14Z" fill="currentColor"></path>
          </svg>
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="foot">
      <div class="wrap foot-grid">
        <div>
          <p class="foot-title">{FULL_TITLE}</p>
        </div>
        <ul class="small">
          <li><a href={LINKS.arxiv}>Paper on arXiv</a></li>
          <li><a href={LINKS.huggingface}>Hugging Face paper page</a></li>
          <li><a href={LINKS.corpus}>GitHub</a></li>
          <li><a href="/paper/#cite">Cite the survey</a></li>
        </ul>
      </div>
    </footer>
    <script>
      // Scroll reveal, like the PersonalAgentEval blog: each block rises and fades in once.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches && 'IntersectionObserver' in window) {
        const targets = document.querySelectorAll<HTMLElement>(
          'main .section-head > *, main section.block > :not(.section-head), main article > *, main .wrap > h1, main .wrap > .lede',
        );
        document.documentElement.classList.add('rv-on');
        const io = new IntersectionObserver(
          (entries) => {
            // Stagger elements that enter together so they don't pop in as one slab.
            entries
              .filter((e) => e.isIntersecting)
              .forEach((e, k) => {
                const el = e.target as HTMLElement;
                el.style.setProperty('--rv-delay', `${Math.min(k, 5) * 70}ms`);
                el.classList.add('in');
                io.unobserve(el);
              });
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
        );
        targets.forEach((el) => {
          el.classList.add('rv');
          io.observe(el);
        });
      }
    </script>
    <script>
      const btn = document.querySelector<HTMLButtonElement>('.theme');
      btn?.addEventListener('click', () => {
        const root = document.documentElement;
        const dark =
          root.dataset.theme === 'dark' ||
          (!root.dataset.theme && matchMedia('(prefers-color-scheme: dark)').matches);
        const next = dark ? 'light' : 'dark';
        root.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (e) {}
        window.dispatchEvent(new CustomEvent('themechange'));
      });
    </script>
  </body>
</html>

<style>
  .skip:focus { position: fixed; top: 8px; left: 8px; width: auto; height: auto; clip: auto; padding: 8px 12px; background: var(--surface); z-index: 100; }
  .top {
    position: sticky; top: 0; z-index: 50;
    background: color-mix(in srgb, var(--bg) 86%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    -webkit-backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--rule);
  }
  .bar { display: flex; align-items: center; gap: 14px; height: 60px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--title-a); text-decoration: none; font-weight: 650; white-space: nowrap; }
  nav { flex: 1; min-width: 0; overflow-x: auto; scrollbar-width: none; }
  nav::-webkit-scrollbar { display: none; }
  nav ul { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  nav li:first-child { margin-left: auto; }
  nav a {
    display: block; padding: 6px 9px; border-radius: 999px; color: var(--ink-2);
    text-decoration: none; font-size: 0.90625rem; white-space: nowrap;
  }
  nav a:hover { background: var(--surface-2); color: var(--ink); }
  nav a[aria-current='page'] { color: var(--ink); background: var(--surface-2); }
  .submit {
    flex: none; padding: 6px 14px; border-radius: 999px; background: var(--ink); color: var(--bg); text-decoration: none;
    font-size: 0.875rem; font-weight: 600; white-space: nowrap;
  }
  .submit:hover { background: var(--accent); }
  .theme {
    flex: none; display: grid; place-items: center; width: 34px; height: 34px; border-radius: 50%;
    border: 1px solid var(--rule); background: var(--surface); color: var(--ink-2); cursor: pointer;
  }
  @media (max-width: 1180px) {
    .bar { flex-wrap: wrap; height: auto; padding-block: 10px; row-gap: 6px; }
    .brand { flex: 1; }
    nav { order: 3; flex-basis: 100%; }
    nav ul { justify-content: flex-start; }
    nav li:first-child { margin-left: 0; }
  }
  .foot { border-top: 1px solid var(--rule); padding-block: 40px 56px; margin-top: 40px; }
  .foot-grid { display: grid; grid-template-columns: 1fr auto; gap: 24px; }
  .foot-title { font-weight: 600; margin-bottom: 6px; color: var(--title-a); }
  .foot ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  @media (max-width: 640px) { .foot-grid { grid-template-columns: 1fr; } }
</style>
