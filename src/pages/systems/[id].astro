---
import SystemPage from '../../components/SystemPage.astro';
import PendingSystemPage from '../../components/PendingSystemPage.astro';
import { pending, systems } from '../../data/index.ts';
import type { PendingSystem, System } from '../../data/normalize.ts';

export function getStaticPaths() {
  return [
    ...systems.map((s) => ({ params: { id: s.id }, props: { s, p: null } })),
    ...pending.map((p) => ({ params: { id: p.id }, props: { s: null, p } })),
  ];
}

const { s, p } = Astro.props as { s: System | null; p: PendingSystem | null };
---

{s ? <SystemPage s={s} /> : p && <PendingSystemPage p={p} />}
