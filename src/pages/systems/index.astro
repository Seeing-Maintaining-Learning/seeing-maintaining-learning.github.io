---
import Base from '../../layouts/Base.astro';
import Explorer from '../../components/viz/Explorer.svelte';
import { pending, systems } from '../../data/index.ts';
import { MODALITY_LABEL } from '../../data/vocab.ts';
import { FACETS, toRow } from '../../lib/facets.ts';
import { breadcrumbs, dataset, website } from '../../lib/seo.ts';

const rows = systems.map(toRow);
const description = `Browse ${systems.length} multimodal agent memory systems by modality, representation, storage, retrieval and T1–T3 management tier.`;
---

<Base
  title="Multimodal Agent Memory Systems: Explorer"
  description={description}
  og="/og/systems.png"
  jsonld={[
    website(),
    dataset('Multimodal agent memory architectures', description, '/systems/', systems.length),
    breadcrumbs([['Home', '/'], ['Systems', '/systems/']]),
  ]}
>
  <section class="wrap head">
    <h1>Systems</h1>
    <p class="lede">
      Every architecture the survey reviewed, with its memory representation, how memory is stored and retrieved, and
      what can change during deployment. Combine filters to find systems that work like yours.
    </p>
    <p><a class="btn" href="/contribute/">Missing a paper? Submit it</a></p>
  </section>
  {
    pending.length > 0 && (
      <section class="wrap pending" aria-labelledby="pending-h">
        <h2 id="pending-h">Recently added — classification pending</h2>
        <p class="small muted">Accepted into the corpus; maintainers are still classifying them, so they are not in the charts yet.</p>
        <ul>
          {pending.map((p) => (
            <li class={`mod-${p.modality}`}>
              <a href={`/systems/${p.id}/`}>{p.name}</a>
              <span class="small muted">{MODALITY_LABEL[p.modality]}{p.year ? ` · ${p.year}` : ''}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }
  <section class="wrap body">
    <Explorer client:load rows={rows} facets={FACETS} />
  </section>
</Base>

<style>
  .head { padding-top: clamp(40px, 6vw, 72px); padding-bottom: 24px; }
  .body { padding-bottom: 48px; }
  .pending { margin-bottom: 28px; padding: 16px 20px; border-radius: 14px; background: var(--surface); border: 1px dashed var(--accent); }
  .pending h2 { font-size: var(--step-1); margin-bottom: 2px; }
  .pending ul { list-style: none; padding: 0; margin: 12px 0 0; display: flex; flex-wrap: wrap; gap: 8px 24px; }
  .pending li { display: flex; flex-direction: column; border-left: 3px solid var(--c); padding-left: 10px; }
</style>
