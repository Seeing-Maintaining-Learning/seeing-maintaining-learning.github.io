---
import Base from '../layouts/Base.astro';
import BarList from '../components/BarList.astro';
import FormationSankey from '../components/viz/FormationSankey.svelte';
import SixForms from '../components/viz/SixForms.svelte';
import ChartSwitch from '../components/viz/ChartSwitch.svelte';
import RepExplainer from '../components/viz/rep/RepExplainer.svelte';
import { leafByModality, leafByTier, retrievalByModality } from '../lib/charts.ts';
import { systems } from '../data/index.ts';
import { sixForms } from '../data/forms.ts';
import { FAMILY_TEXT, HYBRID_EXAMPLES, systemLink } from '../data/taxonomy.ts';
import {
  FAMILIES, FAMILY_LABEL, LEAF_SHORT, LEAVES, MODALITIES, MODALITY_LABEL, REP_CATEGORIES, REP_CATEGORY_LABEL,
  RETRIEVAL_LABEL, SOURCE_ACCESS_LABEL, STORAGE_LABEL,
} from '../data/vocab.ts';
import { countBy, formationFlows } from '../lib/aggregate.ts';
import { breadcrumbs } from '../lib/seo.ts';

// Flow diagram
const flows = formationFlows(systems);
const ids = new Set(flows.flatMap((l) => [l.source, l.target]));
const ORDER: Record<string, string[]> = { m: [...MODALITIES], l: [...LEAVES], s: Object.keys(STORAGE_LABEL), r: Object.keys(RETRIEVAL_LABEL) };
const LABELS: Record<string, Record<string, string>> = { m: MODALITY_LABEL, l: LEAF_SHORT, s: STORAGE_LABEL, r: RETRIEVAL_LABEL };
const STAGE: Record<string, number> = { m: 0, l: 1, s: 2, r: 3 };
const nodes = [...ids].map((id) => {
  const [p, key] = id.split(':');
  return { id, label: LABELS[p][key] ?? key, stage: STAGE[p], order: ORDER[p].indexOf(key) };
});
const modalities = MODALITIES.map((m) => ({ key: m, label: MODALITY_LABEL[m], cls: `mod-${m}` }));
const pathCount = systems.reduce((a, s) => a + s.paths.length, 0);
const access = countBy(systems.flatMap((s) => s.paths), (p) => p.sourceAccess);

// Representation families and hybrids
const catN = countBy(systems, (s) => s.category);
const famN = countBy(systems, (s) => s.families);
const hybridN = catN.hybrid ?? 0;
const topPair = systems.filter((x) => x.hybrid && x.families.length === 2 && x.families.includes('source_preserving_and_modality_native_memory') && x.families.includes('cross_represented_explicit_memory')).length;

const UNITS = ['image or region', 'video frame or clip', 'audiovisual event', 'object track', 'interface state', 'action–observation transition', 'trajectory', 'episode'];
const description =
  'How multimodal agents turn images, video, audio, GUI and embodied experience into memory: six representation forms, hybrids, storage, retrieval, and source access.';
---

<Base
  title="Memory formation and representation in multimodal agents"
  description={description}
  og="/og/formation.png"
  jsonld={[breadcrumbs([['Home', '/'], ['Formation & Representation', '/formation/']])]}
>
  <section class="wrap block intro">
    <p class="small muted">Axis I · Formation and Representation</p>
    <h1>How raw experience becomes memory</h1>
    <p class="lede">
      Formation decides what an agent keeps from what it sees and hears, how that stream is segmented into memory units, and in
      what form those units persist. The survey classifies each memory by the form finally handed back to the model, not by
      how it is indexed. Three families, six forms, and many hybrids.
    </p>
    <ul class="units" aria-label="Typical memory units">
      {UNITS.map((u) => <li>{u}</li>)}
    </ul>
    <ol class="share" aria-label="Systems by representation category">
      {
        REP_CATEGORIES.map((c) => (
          <li style={`flex:${catN[c]}`} class={`cat-${c}`}>
            <span class="lab">{REP_CATEGORY_LABEL[c]}</span>
            <span class="num">{catN[c]}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="wrap block">
    <div class="section-head">
      <h2>From modality to retrieval, across the corpus</h2>
      <p>
        {pathCount} memory paths from {systems.length} systems, traced from the input modality to the stored form, the
        store that holds it, and how it is found again. Band width counts paths; a path using several stores or retrieval
        methods is split evenly between them. Hover to trace a flow, or pick a modality.
      </p>
    </div>
    <FormationSankey client:visible links={flows} nodes={nodes} modalities={modalities} stages={['Modality', 'Represented as', 'Stored in', 'Retrieved by']} />
  </section>

  <section class="wrap block">
    <div class="section-head">
      <h2>One observation, six possible memories</h2>
      <p>The same moment can be kept as pixels, features, text, a graph, a hidden state, or a change to the weights. Pick a form to see how it works, what it keeps, and which systems use it.</p>
    </div>
    <SixForms client:visible forms={sixForms()} />
  </section>

  <section class="wrap block" id="families">
    <div class="section-head">
      <h2>Three families, three trade-offs</h2>
    </div>
    <ul class="fams">
      {
        FAMILIES.map((f, i) => (
          <li class={`fam fam-${i}`}>
            <p class="small muted">{famN[f]} systems use it</p>
            <h3>{FAMILY_LABEL[f]}</h3>
            <p>{FAMILY_TEXT[f].short}</p>
            <p class="trade"><strong>Trade-off.</strong> {FAMILY_TEXT[f].tradeoff}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="wrap block hybrid" id="hybrid">
    <div class="htext">
      <h2>Hybrid memory</h2>
      <p>
        {hybridN} systems ({((hybridN / systems.length) * 100).toFixed(0)}%) combine forms. The most common pattern, used by {topPair}{' '}
        systems, combines explicit records with source- or modality-specific representations. In source-linked designs, a
        record points back to the evidence it came from.
      </p>
      <p class="small muted">
        Named in the paper:{' '}
        {HYBRID_EXAMPLES.map((n, i) => (
          <>
            {systemLink(n) ? <a href={systemLink(n)}>{n}</a> : n}
            {i < HYBRID_EXAMPLES.length - 1 ? ', ' : ''}
          </>
        ))}
      </p>
      <p><a class="btn" href="/systems/?category=hybrid">Browse the {hybridN} hybrid systems</a></p>
    </div>
    <div class="hex"><RepExplainer client:visible kind="hybrid" /></div>
  </section>

  <section class="wrap block">
    <div class="section-head">
      <h2>Which forms each modality uses</h2>
      <p>Systems using each form. A system with several forms counts once in each. Click a bar to list those systems.</p>
    </div>
    <ChartSwitch
      client:visible
      title="Systems by representation form and modality"
      variants={[
        { label: 'Modality', props: leafByModality(systems) },
        { label: 'Tier', props: leafByTier(systems) },
      ]}
    />
  </section>


  <section class="wrap block">
    <div class="section-head">
      <h2>How memory is found again</h2>
      <p>Retrieval and activation methods by modality. Planner- and tool-driven retrieval is as common as similarity search.</p>
    </div>
    <ChartSwitch client:visible title="Systems by retrieval method and modality" variants={[{ label: 'Modality', props: retrievalByModality(systems) }]} />
  </section>

  <section class="wrap block twocol">
    <div class="section-head">
      <h2>Can the agent get back to the source?</h2>
      <p>
        Abstraction saves space but can cut the link to the original evidence. Only some memory paths keep the raw
        observation available, or link back to it, so that a summary can be checked against what was actually seen.
      </p>
    </div>
    <BarList
      unit="memory paths"
      bars={['direct', 'linked_recoverable', 'retained_not_accessible', 'none'].map((k) => ({ label: SOURCE_ACCESS_LABEL[k], value: access[k] ?? 0 }))}
    />
  </section>
</Base>

<style>
  .intro h1 { max-width: 16ch; }
  .units { list-style: none; padding: 0; margin: 24px 0 0; display: flex; flex-wrap: wrap; gap: 6px; }
  .units li { font-size: var(--step--1); padding: 4px 10px; border-radius: 999px; background: var(--surface); border: 1px solid var(--rule); color: var(--ink-2); }
  .share { list-style: none; display: flex; gap: 3px; padding: 0; margin: 28px 0 0; height: 60px; }
  .share li { display: flex; flex-direction: column; justify-content: space-between; padding: 8px 10px; border-radius: 6px; min-width: 0; background: var(--surface); border: 1px solid var(--rule); overflow: hidden; }
  .share .lab { font-size: 0.75rem; color: var(--muted); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .share .num { font-weight: 650; }
  .share .cat-hybrid { background: color-mix(in srgb, var(--accent) 12%, var(--surface)); border-color: var(--accent); }
  .fams { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; }
  .fam { padding: 18px 20px; border-radius: 14px; background: var(--surface); border: 1px solid var(--rule); border-top: 4px solid var(--fc); }
  .fam-0 { --fc: var(--m-video); }
  .fam-1 { --fc: var(--m-audio); }
  .fam-2 { --fc: var(--t1); }
  .fam h3 { margin: 4px 0 8px; }
  .trade { color: var(--ink-2); font-size: 0.9375rem; }
  .hybrid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 420px); gap: 40px; align-items: center; }
  .htext p { color: var(--ink-2); max-width: 60ch; }
  .twocol { display: grid; grid-template-columns: 1fr 1.2fr; gap: 40px; align-items: center; }
  @media (max-width: 860px) {
    .twocol, .hybrid, .fams { grid-template-columns: 1fr; }
    .share .lab { display: none; }
  }
</style>
