---
import Base from '../layouts/Base.astro';
import Observatory from '../components/obs/Observatory.astro';
import { benchmarks, pending, scoredBenchmarks, systems } from '../data/index.ts';
import { ARXIV_ID, AUTHORS, BIBTEX, DESCRIPTION, LINKS, SUBTITLE, TITLE } from '../data/paper.ts';
import { MODALITIES, MODALITY_LABEL, MODALITY_SLUG } from '../data/vocab.ts';
import { countBy, crossMatrix } from '../lib/aggregate.ts';
import { scholarlyArticle, website } from '../lib/seo.ts';

const points = systems.map((s) => {
  const d = new Date(s.date);
  const doy = Number.isNaN(d.getTime()) ? 0.5 : (d.getTime() - Date.UTC(s.year, 0, 1)) / (365 * 864e5);
  return {
    id: s.id,
    name: s.name,
    tier: s.tier,
    modality: s.modality,
    modalityLabel: MODALITY_LABEL[s.modality],
    category: s.category,
    families: s.families,
    year: s.year,
    t: s.year + doy,
  };
});
const tiers = countBy(systems, (s) => s.tier);
const cm = crossMatrix(systems);
const hybridPct = ((cm.hybrid.T1 + cm.hybrid.T2 + cm.hybrid.T3) / systems.length) * 100;
const cfDirect = scoredBenchmarks.filter((b) => b.coverage[3] === 'direct').length;
const explicitT3 = cm.cross.T3 + cm.hybrid.T3;

const recent = [
  ...systems.filter((s) => s.isNew).map((s) => ({ name: s.name, href: `/systems/${s.id}/`, kind: 'System', modality: s.modality, date: s.date })),
  ...pending.filter((p) => p.isNew).map((p) => ({ name: p.name, href: `/systems/${p.id}/`, kind: 'System · classification pending', modality: p.modality, date: p.date })),
  ...benchmarks.filter((b) => b.isNew).map((b) => ({ name: b.name, href: `/benchmarks/${b.id}/`, kind: 'Benchmark', modality: b.modality, date: b.date ?? '' })),
]
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 6);

// Door tints: Axis I sky, Axis II mint, modalities peach.
const DOORS = [
  { q: 'What does stored memory look like?', a: 'Six representation forms in three families, and the hybrids that combine them.', href: '/formation/#families', tag: 'Axis I · Representation', tint: 'sky' },
  { q: 'How does experience become memory?', a: 'From pixels and speech to records, graphs, states, and weights, traced across the corpus.', href: '/formation/', tag: 'Axis I · Formation', tint: 'sky' },
  { q: 'What can change while the agent runs?', a: 'Static, dynamic, and self-evolving memory, with interactive walk-throughs.', href: '/management/', tag: 'Axis II · Management', tint: 'mint' },
  { q: 'I work on one modality.', a: 'Systems and benchmarks for image, video, audio, GUI, or embodied agents.', href: '/modalities/', tag: 'Modalities', tint: 'peach' },
];
const firstAuthor = AUTHORS[0]?.name.split(' ').at(-1) ?? '';
---

<Base
  title={`${TITLE}: Multimodal Agent Memory Survey`}
  description={DESCRIPTION}
  noSuffix
  jsonld={[website(), scholarlyArticle()]}
>
  <section class="wrap hero">
    <div class="intro">
      <h1>
        <span class="t">{TITLE}</span>
        <span class="s">{SUBTITLE}</span>
      </h1>
      <div class="side">
      <p class="lede">
        A survey of how multimodal agents remember: how they turn what they see and hear into memory, and how that memory
        is maintained and improved through experience. {`We reviewed ${systems.length} systems and ${benchmarks.length} benchmarks across five modalities.`}
      </p>
      <p class="cta">
        <a class="btn primary" href={LINKS.arxiv}>Read the paper on arXiv</a>
        <a class="btn" href="/systems/">Browse the systems</a>
        <a class="btn" href="/contribute/">Submit a paper</a>
      </p>
      </div>
    </div>
    <Observatory points={points} />
  </section>


  {
    recent.length > 0 && (
      <section class="wrap recent" aria-labelledby="recent-h">
        <div class="rh">
          <h2 id="recent-h">Recently added</h2>
          <a class="small" href="/contribute/">Submit a paper</a>
        </div>
        <ul>
          {recent.map((r) => (
            <li class={`mod-${r.modality}`}>
              <a href={r.href}>{r.name}</a>
              <span class="small muted">{r.kind} · {MODALITY_LABEL[r.modality]}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="wrap block">
    <div class="section-head">
      <h2>Find your way in</h2>
      <p>Start from the question you have. Each view uses the same corpus.</p>
    </div>
    <ul class="doors">
      {
        DOORS.map((d) => (
          <li class={`t-${d.tint}`}>
            <a href={d.href}>
              <span class={`pill ${d.tint}`}>{d.tag}</span>
              <span class="q">{d.q}</span>
              <span class="a">{d.a}</span>
            </a>
          </li>
        ))
      }
    </ul>
    <p class="mods small">
      Or jump to a modality:{' '}
      {MODALITIES.map((m) => <a class={`chip mod-${m}`} href={`/modalities/${MODALITY_SLUG[m]}/`}><span class="dot" />{MODALITY_LABEL[m]}</a>)}
    </p>
  </section>

  <section class="wrap block">
    <div class="section-head">
      <h2>What the corpus shows</h2>
    </div>
    <ol class="findings">
      <li>
        <p class="f"><span class="num">{((tiers.T2 / systems.length) * 100).toFixed(1)}%</span> of systems update memory under a fixed policy (T2).</p>
        <p class="muted">Dynamic memory is the norm. Only {tiers.T3} systems let feedback change the policy itself.</p>
        <a href="/management/">See the tiers</a>
      </li>
      <li>
        <p class="f"><span class="num">{hybridPct.toFixed(1)}%</span> of systems are hybrids.</p>
        <p class="muted">Most pair explicit records with source-level evidence or modality-specific encodings.</p>
        <a href="/formation/#hybrid">See hybrid patterns</a>
      </li>
      <li>
        <p class="f"><span class="num">{explicitT3} of {tiers.T3}</span> self-evolving systems keep explicit memory.</p>
        <p class="muted">Policies evolve where memory can be read and edited; none of the purely latent systems do.</p>
        <a href="/management/">See the matrix</a>
      </li>
      <li>
        <p class="f"><span class="num">{cfDirect} of {scoredBenchmarks.length}</span> benchmarks directly test conflicting memories.</p>
        <p class="muted">Evaluation favors finding old evidence over keeping memory correct as the world changes.</p>
        <a href="/benchmarks/">See benchmark coverage</a>
      </li>
    </ol>
  </section>

  <section class="wrap cite" aria-labelledby="cite-h">
    <h2 id="cite-h" class="pill lilac">Cite the survey</h2>
    <p class="ref">
      {firstAuthor} et al. (2026). <cite>{TITLE}: {SUBTITLE}</cite>. arXiv:{ARXIV_ID}.
    </p>
    <div class="acts">
      <button type="button" class="btn sm copy" data-bib={BIBTEX}>Copy BibTeX</button>
      <a class="small" href="/paper/#cite">Authors and full entry</a>
    </div>
  </section>
</Base>

<script>
  const btn = document.querySelector<HTMLButtonElement>('.cite .copy');
  btn?.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(btn.dataset.bib ?? '');
      btn.textContent = 'Copied';
    } catch {
      btn.textContent = 'Copy failed: see the paper page';
    }
    setTimeout(() => (btn.textContent = 'Copy BibTeX'), 2000);
  });
</script>

<style>
  .hero { padding-top: clamp(32px, 5vw, 64px); padding-bottom: clamp(40px, 6vw, 72px); display: grid; gap: 32px; }
  h1 { margin: 0; font-size: clamp(2.4rem, 4.6vw, 3.6rem); letter-spacing: -0.01em; line-height: 1.02; font-weight: 850; }
  h1 .t {
    display: block;
    color: var(--title-a);
    background: linear-gradient(100deg, var(--title-a) 10%, var(--title-b) 90%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    padding-bottom: 0.06em;
  }
  h1 .s { display: block; font-size: 0.5em; font-weight: 700; letter-spacing: 0; color: var(--title-b); margin-top: 10px; line-height: 1.2; }
  .intro { display: grid; grid-template-columns: 1.15fr 1fr; gap: 24px 48px; align-items: end; }
  .side .lede { font-size: 1.0625rem; margin-bottom: 0; }
  @media (max-width: 900px) { .intro { grid-template-columns: 1fr; } }
  .cta { display: flex; flex-wrap: wrap; gap: 8px; margin: 18px 0 0; }
  .btn { font: inherit; padding: 9px 18px; border-radius: 999px; border: 1px solid var(--rule); background: var(--surface); color: var(--ink); text-decoration: none; }
  .btn.primary { background: var(--ink); color: var(--bg); border-color: var(--ink); }
  .doors { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 12px; }
  .doors a {
    display: flex; flex-direction: column; align-items: flex-start; gap: 10px; height: 100%; padding: 18px 20px 20px; border-radius: 20px;
    border: 1px solid color-mix(in srgb, var(--tc) 55%, var(--rule)); background: color-mix(in srgb, var(--tc) 45%, var(--surface));
    color: var(--ink); text-decoration: none; transition: border-color var(--dur-1), transform var(--dur-2) var(--ease);
  }
  .t-sky { --tc: var(--tint-sky); --tk: var(--tint-ink-sky); }
  .t-mint { --tc: var(--tint-mint); --tk: var(--tint-ink-mint); }
  .t-peach { --tc: var(--tint-peach); --tk: var(--tint-ink-peach); }
  .doors .pill { background: var(--surface); }
  .doors a:hover { border-color: var(--tk); transform: translateY(-2px); }
  .doors a:hover .q { text-decoration: underline; text-decoration-thickness: 1px; }
  .q { font-size: var(--step-1); font-weight: 800; line-height: 1.2; color: var(--title-a); }
  .a { color: var(--ink-2); font-size: 0.9375rem; }
  .mods { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; margin-top: 20px; }
  .findings { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 32px; }
  .findings li { border-top: 3px solid var(--title-b); padding-top: 14px; }
  .f { font-size: var(--step-1); font-weight: 700; line-height: 1.3; }
  .f .num { color: var(--accent-ink); }
  .recent { padding-block: 8px 24px; }
  .rh { display: flex; align-items: baseline; justify-content: space-between; gap: 12px; }
  .rh h2 { font-size: var(--step-1); }
  .recent ul { list-style: none; padding: 0; margin: 8px 0 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 10px; }
  .recent li { display: flex; flex-direction: column; gap: 2px; padding: 10px 14px; border-radius: 12px; background: var(--surface); border: 1px solid var(--rule); border-left: 4px solid var(--c); }
  .recent a { font-weight: 600; color: var(--ink); }
  .cite {
    display: flex; flex-wrap: wrap; align-items: center; gap: 10px 16px; margin-block: 8px 24px; padding-block: 16px;
    border-top: 1px solid var(--rule);
  }
  .cite h2 { margin: 0; font-size: 1.0625rem; }
  .cite .ref { margin: 0; flex: 1 1 320px; min-width: 0; font-size: 0.9375rem; color: var(--ink-2); }
  .cite cite { font-style: italic; color: var(--ink); }
  .acts { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .btn.sm { padding: 5px 14px; font-size: 0.875rem; }
</style>
