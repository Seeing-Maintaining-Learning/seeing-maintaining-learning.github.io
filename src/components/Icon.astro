---
import { ICONS } from '../data/icons.ts';
interface Props { name: string; size?: number; label?: string }
const { name, size = 16, label = '' } = Astro.props;
---

<svg
  class="icon"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  role={label ? 'img' : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : 'true'}
  set:html={ICONS[name] ?? ''}
/>
